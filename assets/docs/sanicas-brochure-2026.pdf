         <photoshop:TextLayers>
            <rdf:Bag>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>About Sree Amman Trust</photoshop:LayerName>
                  <photoshop:LayerText>About Sree Amman Trust</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Sree Amman Trust is a pioneering educational and technological </photoshop:LayerName>
                  <photoshop:LayerText>Sree Amman Trust is a pioneering educational and technological organization with over three decades of excellence in education. Founded in 1986 by Tmt. T. Jayalakshmi, M.A., the Trust manages ten prestigious institutions across Erode and Coimbatore, shaping the academic, personal, and professional development of thousands of students. </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>Sree Amman Trust is a pioneering educational and technological </photoshop:LayerName>
                  <photoshop:LayerText>Sree Amman Trust is a pioneering educational and technological organization with over three decades of excellence in education. Founded in 1986 by Tmt. T. Jayalakshmi, M.A., the Trust manages ten prestigious institutions across Erode and Coimbatore, shaping the academic, personal,and professional development of thousands of students. </photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>SAN International College of Arts and Science (SANICAS)</photoshop:LayerName>
                  <photoshop:LayerText>SAN International College of Arts and Science (SANICAS)</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>SAN International College of Arts and Science (SANICAS),Affilia</photoshop:LayerName>
                  <photoshop:LayerText>SAN International College of Arts and Science (SANICAS),Affiliated to Bharathiar University,  Coimbatore | Approved by the Government of Tamil Nadu |UGC Recognized   SANICAS provides world-class education through innovative teaching methods and industry focused programs. Experienced faculty nurture critical thinking, creativity, and holistic development. Students gain hands-on experience in modern labs, career-oriented projects, and global exposure through exchange programs and research collaborations.</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>VISION</photoshop:LayerName>
                  <photoshop:LayerText>VISION</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>MISSION</photoshop:LayerName>
                  <photoshop:LayerText>MISSION</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>To nurture future leaders and thinkers who possess the academic</photoshop:LayerName>
                  <photoshop:LayerText>To nurture future leaders and thinkers who possess the academic knowledge, practical skills,and  ethical values to succeed in their careers and life..</photoshop:LayerText>
               </rdf:li>
               <rdf:li rdf:parseType="Resource">
                  <photoshop:LayerName>To provide world-class education and foster an environment that</photoshop:LayerName>
                  <photoshop:LayerText>To provide world-class education and foster an environment that encourages academic excellence,innovation, and personal growth, preparing students to excel in an ever-evolving global lanscape.</photoshop:LayerText>
               </rdf:li>
